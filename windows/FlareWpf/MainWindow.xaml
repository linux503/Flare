<Window x:Class="FlareWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Flare Windows Web Long Screenshot"
        Height="860"
        Width="1320">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="UrlBox" Width="680" Height="30" Text="https://example.com" />
            <Button x:Name="OpenBtn" Margin="8,0,0,0" Width="90" Height="30" Click="OpenBtn_OnClick">打开</Button>
            <Button x:Name="CaptureBtn" Margin="8,0,0,0" Width="120" Height="30" Click="CaptureBtn_OnClick">自动长截图</Button>
            <Button x:Name="SaveBtn" Margin="8,0,0,0" Width="90" Height="30" IsEnabled="False" Click="SaveBtn_OnClick">保存 PNG</Button>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
                <wv2:WebView2 x:Name="Browser"/>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Margin="2,8,0,0"
                   FontSize="12"
                   Foreground="#555"
                   Text="就绪：仅网页长截图（WebView2）。" />
    </Grid>
</Window>
